# ==========================================================
# CloudLab-AI — Environment Variables (example)
# Copy to .env and fill in real values. Never commit .env.
# ==========================================================

# --- App ---
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000
PORT=4000

# --- Database ---
DATABASE_URL=postgresql://cloudlab:cloudlab@localhost:5432/cloudlab_ai?schema=public

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
JWT_SECRET=replace_with_a_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_REFRESH_EXPIRES_IN=30d

# --- GitHub OAuth ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/api/v1/auth/github/callback

# --- Google OAuth (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- AI Provider ---
AI_PROVIDER=local
AI_API_KEY=
AI_MODEL=

# --- Docker ---
# Path to Docker socket or tcp host. Backend-only, never exposed to frontend.
DOCKER_HOST=/var/run/docker.sock

# --- Misc ---
LOG_LEVEL=info
